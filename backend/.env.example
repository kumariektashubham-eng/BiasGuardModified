# BiasGuard AI Environment Configuration

PROJECT_NAME="BiasGuard AI"
API_PREFIX="/api"

# MongoDB Connectivity (MongoDB Atlas URI or Local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# For Local fallback: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=biasguard
DATABASE_NAME=biasguard

# Security & Authentication
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / OpenAI API Integration (Used for technical evaluation & RAG)
# Leave empty or with placeholder to run in intelligent offline semantic mock mode
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MOCK_AI_MODE=false

# Bias Sensitivity Threshold (Delta in score between interviewer and AI to flag discrepancy)
BIAS_SCORE_DELTA_THRESHOLD=2.5

# Speech-to-Text Transcription Provider (groq or openai)
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3

# LiveKit WebRTC Video & Audio Interviews
LIVEKIT_URL=wss://<your-livekit-host>.livekit.cloud
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me

# Email Invitations (console, resend, smtp)
EMAIL_PROVIDER=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=BiasGuard AI <interviews@biasguard.ai>
FRONTEND_BASE_URL=http://localhost:5173
INVITATION_EXPIRY_HOURS=48
